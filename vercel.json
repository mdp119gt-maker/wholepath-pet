{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/staff.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    }
  ]
}
